# content, not source; never committed.
server/uploads/

# Test / tooling caches
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db

# Playwright artifacts
test-results/
playwright-report/
